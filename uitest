				local NewW = math.clamp(StartSize.X + Delta.X, WindowConfig.MinSize.X, WindowConfig.MaxSize.X)
				local NewH = math.clamp(StartSize.Y + Delta.Y, WindowConfig.MinSize.Y, WindowConfig.MaxSize.Y)
