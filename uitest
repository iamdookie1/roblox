			function ElementFunction:AddProgressBar(ProgressConfig)
				ProgressConfig = ProgressConfig or {}
				local Steps = ProgressConfig.Steps or {}
				local totalSteps = #Steps
				local currentStep = math.clamp(ProgressConfig.Default or 1, 1, math.max(totalSteps, 1))

				local ProgressFrame = Create("Frame", {
					Size = UDim2.new(1, 0, 0, 55),
					BackgroundTransparency = 1,
					Parent = ItemParent
				})

				local NameLabel = AddThemeObject(Create("TextLabel", {
					Text = ProgressConfig.Name or "",
					Font = Enum.Font.GothamSemibold,
					TextSize = 13,
					Size = UDim2.new(1, -12, 0, 16),
					Position = UDim2.new(0, 12, 0, 0),
					BackgroundTransparency = 1,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = ProgressFrame
				}), "Text")

				local BarBg = AddThemeObject(Create("Frame", {
					Size = UDim2.new(1, -24, 0, 10),
					Position = UDim2.new(0, 12, 0, 22),
					BorderSizePixel = 0,
					Parent = ProgressFrame
				}), "Second")
				Create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = BarBg})

				local fillPct = totalSteps > 1 and ((currentStep - 1) / (totalSteps - 1)) or (currentStep >= 1 and 1 or 0)
				local BarFill = Create("Frame", {
					Size = UDim2.new(fillPct, 0, 1, 0),
					BackgroundColor3 = Color3.fromRGB(9, 149, 98),
					BorderSizePixel = 0,
					Parent = BarBg
				})
				Create("UICorner", {CornerRadius = UDim.new(0, 5), Parent = BarFill})

				local StepLabel = AddThemeObject(Create("TextLabel", {
					Text = (totalSteps > 0 and Steps[currentStep]) or "",
					Font = Enum.Font.Gotham,
					TextSize = 11,
					Size = UDim2.new(1, -12, 0, 13),
					Position = UDim2.new(0, 12, 0, 38),
					BackgroundTransparency = 1,
					TextXAlignment = Enum.TextXAlignment.Left,
					Parent = ProgressFrame
				}), "TextDark")

				local ProgObj = {Value = currentStep}
				function ProgObj:SetStep(n)
					if totalSteps == 0 then return end
					n = math.clamp(n, 1, totalSteps)
					self.Value = n
					local pct = totalSteps > 1 and ((n - 1) / (totalSteps - 1)) or 1
					TweenService:Create(BarFill, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(pct, 0, 1, 0)}):Play()
					StepLabel.Text = Steps[n] or ""
				end
				function ProgObj:SetName(str)
					NameLabel.Text = str or ""
				end
				return ProgObj
			end

			function ElementFunction:AddThemeSwitcher()
				local themeNames = {}
				for name in pairs(unknown.Themes) do
					table.insert(themeNames, name)
				end
				table.sort(themeNames)

				return self:AddDropdown({
					Name = "Theme",
					Options = themeNames,
					Default = unknown.SelectedTheme,
					Callback = function(selected)
						if unknown.Themes[selected] then
							unknown.SelectedTheme = selected
							SetTheme()
						end
					end
				})
			end

			return ElementFunction
		end

