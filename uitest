			ElementFunction[i] = v
		end

		-- Expose SetLocked on the returned element table
		ElementFunction.SetLocked = function(_, locked)
			Tab:SetLocked(locked)
		end

		return ElementFunction
	end

	-- SetTab: switch to a tab by name, fallback to first tab
	function TabFunction:SetTab(name)
		local found = false
		for _, Tab in next, TabHolder:GetChildren() do
			if Tab:IsA("TextButton") and Tab.Title.Text == name then
				Tab:Invoke() -- simulate click via firing event
				found = true
				break
			end
		end
		if not found then
			-- fallback: activate first tab
			local firstTab = TabHolder:FindFirstChildWhichIsA("TextButton")
			if firstTab then
				firstTab.MouseButton1Click:Fire()
			end
		end
	end

	-- WindowLocked: prevent dragging + hide close/minimize
	local WindowLockedState = false
	function TabFunction:WindowLocked(locked)
		WindowLockedState = locked
		CloseBtn.Visible = not locked
		MinimizeBtn.Visible = not locked
		DragPoint.Active = not locked
	end

	-- Apply DefaultTab after all tabs loaded (defer one frame)
	if WindowConfig.DefaultTab then
		task.defer(function()
			TabFunction:SetTab(WindowConfig.DefaultTab)
		end)
	end

	return TabFunction
end

